<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Blok dotfile (.env, .git, .htaccess, .vite, .prettierrc, dst)
    RewriteRule (^\.|/\.) - [F,L]

    # Blok akses langsung ke source code & folder sensitif
    RewriteRule ^(bin|configs|database|dist|node_modules|pages|partials|src|system|vendor)(/|$) - [F,L]

    # Blok arsip / file proyek yang tidak boleh diakses publik
    RewriteRule \.(zip|tar|gz|sql|log|bak|lock|sqlite|sqlite-wal|sqlite-shm)$ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|bun\.lock|vite\.config\.js|README\.md)$ - [F,L]

    # Folder demo (mis. /barbershop/) — jangan strip trailing slash agar relative
    # path (img/...) resolve; biarkan front controller yang menyajikan index.html.
    RewriteCond %{DOCUMENT_ROOT}/demo%{REQUEST_URI} !-d
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # File demo (misal demo/barbershop/img/...) langsung dilayani jika ada
    RewriteCond %{DOCUMENT_ROOT}/demo%{REQUEST_URI} -f
    RewriteRule ^(.*)$ demo/$1 [END]

    # File statis diambil dari public/ (/build/..., /images/..., /logo/..., /videos/..., /robots.txt)
    # Jalan untuk docroot root (Apache) — request /build/app.css -> public/build/app.css
    RewriteCond %{REQUEST_URI} !\.php$
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.+)$ public/$1 [END]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
